# Database
# Local dev: port 5435 (docker run -p 5435:5432 postgres:16-alpine ...)
# Docker-compose: postgresql://callanalytics:password@db:5432/callanalytics
DATABASE_URL=postgresql://callanalytics:password@localhost:5435/callanalytics

# OpenAI (Whisper STT + gpt-5-mini fallback + gpt-5.4 last resort)
OPENAI_API_KEY=sk-...
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_DIRECT_MODEL=gpt-5.4

# Gemini direct (Google AI Studio, OpenAI-compat endpoint)
# Получение ключа: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_DIRECT_MODEL=gemini-3-flash-preview

# kie.ai — временно скрыта (KIE_DISABLED=1). Чтобы включить обратно: KIE_DISABLED=0
KIE_DISABLED=1
KIE_API_KEY=
KIE_PRIMARY_BASE_URL=https://api.kie.ai/gemini-3-flash/v1
KIE_FALLBACK_BASE_URL=https://api.kie.ai/gemini-3-pro/v1
LLM_MODEL=gemini-3-flash
LLM_FALLBACK_MODEL=gemini-3-pro

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=ru

# pyannote (requires HuggingFace token)
HF_TOKEN=hf_...

# Limits
MAX_FILE_SIZE_MB=500
MAX_BATCH_SIZE=20
MIN_DURATION_SEC=3
MAX_DURATION_SEC=14400
AUDIO_RETENTION_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Data paths
UPLOADS_DIR=/app/data/uploads
AUDIO_DIR=/app/data/audio

# Frontend (build-time)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
